3600:                  <label className={className} key={field.key}>
3601:                    {field.label}
3602:                    <select value={value} onChange={(event) => handleFieldChange(field.key, event.target.value)}>
3603:                      {field.options.map(([optionValue, optionLabel]) => (
3604:                        <option value={optionValue} key={optionValue}>
3605:                          {optionLabel}
3606:                        </option>
3607:                      ))}
3608:                    </select>
3609:                    {field.helpText ? <small>{field.helpText}</small> : null}
3610:                  </label>
3611:                );
3612:              }
3613:              if (field.type === "color") {
3614:                return (
3615:                  <label className={`${className} onboarding-color-field`} key={field.key}>
3616:                    {field.label}
3617:                    <div className="onboarding-color-control">
3618:                      <input
3619:                        type="color"
3620:                        value={normalizeColorInputValue(value, field.placeholder)}
3621:                        onChange={(event) => handleFieldChange(field.key, event.target.value)}
3622:                      />
3623:                      <input
3624:                        type="text"
3625:                        placeholder={field.placeholder}
3626:                        value={value}
3627:                        onChange={(event) => handleFieldChange(field.key, event.target.value)}
3628:                      />
3629:                    </div>
3630:                    {field.helpText ? <small>{field.helpText}</small> : null}
3631:                  </label>
3632:                );
3633:              }
3634:              return (
3635:                <label className={className} key={field.key}>
3636:                  {field.label}
3637:                  <input
3638:                    type={field.type}
3639:                    placeholder={field.placeholder}
3640:                    value={value}
3641:                    onChange={(event) => handleFieldChange(field.key, event.target.value)}
3642:                  />
3643:                  {field.helpText ? <small>{field.helpText}</small> : null}
3644:                </label>
3645:              );
3646:            })}
3647:          </div>
3648:
3649:          <div className="onboarding-actions">
3650:            <button className="secondary-action" type="button" onClick={handleSaveChanges} disabled={!canSave}>
3651:              Save changes
3652:            </button>
3653:            <button className="primary-action" type="button" onClick={handleConfirm} disabled={!canConfirm}>
3654:              Confirm profile
3655:            </button>
3656:          </div>
3657:        </>
3658:      )}
3659:
3660:      {showReplaceWarning && (
3661:        <Modal
3662:          eyebrow="Replace draft"
3663:          title="Replace your current onboarding draft?"
3664:          onClose={() => {
3665:            setShowReplaceWarning(false);
3666:            setPendingUrl("");
3667:          }}
3668:        >
3669:          <div className="onboarding-modal-copy">
3670:            <p>This will replace your current profile draft with fresh website crawl data.</p>
3671:            <div className="onboarding-actions">
3672:              <button
3673:                className="secondary-action"
3674:                type="button"
3675:                onClick={() => {
3676:                  setShowReplaceWarning(false);
3677:                  setPendingUrl("");
3678:                }}
3679:              >
3680:                Keep current draft
3681:              </button>
3682:              <button className="primary-action" type="button" onClick={() => handleCrawl(pendingUrl)}>
3683:                Replace draft
3684:              </button>
3685:            </div>
3686:          </div>
3687:        </Modal>
3688:      )}
3689:    </section>
3690:  );
3691:}
